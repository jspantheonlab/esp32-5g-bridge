# Settings for the 5G Bridge dongle (read by bridge5g.service and bridge5g-gadget.service).

# Modem AT port. "auto" finds the Quectel AT interface under /dev/serial/by-id.
BRIDGE_AT_PORT=auto

# APN. "internet" = pick automatically from the SIM (China Mobile cmnet, Unicom 3gnet,
# Telecom ctnet, Broadnet cbnet). Set your carrier's APN if data doesn't come up.
BRIDGE_APN=internet
BRIDGE_SIM_PIN=

# ALSA device carrying call audio from the modem's USB audio. "auto" looks for the
# modem's sound card; "none" disables call audio.
BRIDGE_AUDIO_DEVICE=auto
# AT command that routes call audio to USB audio. Check your module's AT manual.
BRIDGE_VOICE_ROUTE_CMD=AT+QPCMV=1,2

# Where the iPhone app connects (the Pi's end of the USB-C link).
BRIDGE_LISTEN=192.168.7.1:5005
BRIDGE_AUDIO_PORT=5004

# USB gadget function presented to the iPhone: ecm (default) or ncm.
BRIDGE_USB_FUNCTION=ecm

RUST_LOG=info
